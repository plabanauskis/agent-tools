# pibox — sandboxed autonomous Pi via Docker + sysbox.
NAME=pibox
ENTRYPOINT=bin/pibox
COMMANDS="pibox"
DEPS="docker sysbox-runc pi"
PLATFORM="linux"
DESC="Sandboxed autonomous Pi via Docker + sysbox"
POST_ENABLE="Run 'pibox build' once to build the sandbox image (~5 min, ~5GB). 'pibox doctor' verifies the sysbox runtime is registered with Docker."
